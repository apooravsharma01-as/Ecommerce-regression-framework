  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:db": "playwright test tests/db",
    "allure:generate": "cp environment.properties allure-results/environment.properties && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "impact": "node agents/runImpact.js",
    "impact:scan": "node agents/runImpact.js --scan-only",
    "impact:test": "node testImpactPipeline.js",
    "phase4:test": "node testPhase4.js",
    "phase5:test": "node testPhase5.js",
    "scaffold:test": "node testScaffold.js",
    "regression": "node agents/runRegression.js",
    "regression:analyze": "node agents/runRegression.js --no-run",
    "db:diagnose": "node scripts/diagnose-db.js",
    "db:setup": "node scripts/setup-uat-db.js",
    "db:tunnel": "bash scripts/start-uat-db-tunnel.sh",
    "dashboard:api": "node server/dashboardServer.js",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard": "node server/runDashboard.js"
  },
  "keywords": [],
  "author": "",
