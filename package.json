  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.9.0"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
